{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "rootDir": "src",
        "outDir": "dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "sourceMap": true,
        "paths": {
            "@/*": ["./src/*"],
            "@test/*": ["./test/*"]
        }
    },
    "tsc-alias": {
        "resolveFullPaths": true
    },
    "include": ["src"]
}
